#include <amxmodx>

// v35: cvar_compat -- the phone gamedll does not register some cvars that
// popular mods take for granted, and many mod addons call get_cvar_pointer()
// in plugin_init() for cvars that the main mod registers LATER (plugins.ini
// order). A zero pointer there makes every later get_pcvar_num() abort with
// "Invalid CVAR pointer (handle 0) used in native get_pcvar_num".
// This plugin pre-registers those cvars at the very top of plugins.ini so
// every lookup succeeds no matter what order the user installs things in:
//   - bot_quota           : CZ-bot cvar, NOT registered by the ported gamedll
//   - amx_show_activity   : normally owned by admin.amxx (order-dependent)
//   - the full ZP 4.3 zp_* set (defaults identical to zombie_plague40.sma).
// Mods that register the same cvar later simply reuse the existing one and
// get a valid handle back (AMXX CvarManager re-uses engine-existing cvars).

public plugin_init()
{
	register_plugin("CVAR Compat", "1.0", "cs16-amxx-android")

	// platform-missing cvars
	register_cvar("bot_quota", "0")
	register_cvar("amx_show_activity", "2")

	// Zombie Plague 4.3 full cvar surface (canonical defaults)
	register_cvar("zp_admin_knife_models_human", "0")
	register_cvar("zp_admin_knife_models_zombie", "0")
	register_cvar("zp_admin_models_human", "1")
	register_cvar("zp_admin_models_zombie", "1")
	register_cvar("zp_block_suicide", "1")
	register_cvar("zp_blockuse_pushables", "1")
	register_cvar("zp_buy_custom", "1")
	register_cvar("zp_buyzone_time", "0.0")
	register_cvar("zp_deathmatch", "0")
	register_cvar("zp_delay", "10")
	register_cvar("zp_extra_antidote", "1")
	register_cvar("zp_extra_antidote_limit", "999")
	register_cvar("zp_extra_infbomb", "1")
	register_cvar("zp_extra_infbomb_limit", "999")
	register_cvar("zp_extra_items", "1")
	register_cvar("zp_extra_madness", "1")
	register_cvar("zp_extra_madness_duration", "5.0")
	register_cvar("zp_extra_madness_limit", "999")
	register_cvar("zp_extra_nvision", "1")
	register_cvar("zp_extra_weapons", "1")
	register_cvar("zp_fire_damage", "5")
	register_cvar("zp_fire_duration", "10")
