	register_cvar("zp_flare_size", "25")
	register_cvar("zp_flash_charge", "5")
	register_cvar("zp_flash_custom", "0")
	register_cvar("zp_flash_distance", "1000")
	register_cvar("zp_flash_drain", "1")
	register_cvar("zp_flash_show_all", "1")
	register_cvar("zp_flash_size", "10")
	register_cvar("zp_frost_duration", "3")
	register_cvar("zp_frost_grenades", "1")
	register_cvar("zp_hud_display", "1")
